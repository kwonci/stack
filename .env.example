# stack 전체의 단일 설정 파일. `cp .env.example .env` 후 채우세요.
# - scripts/lib.sh 가 이 파일을 읽어 TF_VAR_* 로 terraform 에 넘기고,
#   각 레이어의 terraform.tfvars 도 여기서 생성합니다(파생물이라 gitignore 됩니다).
# - 동일한 파일이 EC2 의 /opt/stack/.env 로 복사되어 docker compose --env-file 로 쓰입니다.
#   (secret 이 호스트로 건너가므로 mode 600 으로 전송됩니다)
# - .env 없이 도는 것은 `make validate` 뿐입니다. 그때는 이 예시 파일이 대신 쓰입니다.
#
# 반드시 채워야 하는 것: DOMAIN, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID,
# ACCESS_EMAILS, CF_ORIGIN_SECRET, GRAFANA_ADMIN_PASSWORD.
# 나머지는 아래 기본값 그대로 둬도 뜹니다.

# --- AWS / terraform ---
# tfstate 버킷 이름(<PROJECT>-tfstate-<계정ID>)과 스냅샷을 거르는 Project 태그가
# 여기서 나옵니다. 부트스트랩 이후에 바꾸면 state 를 잃어버립니다.
PROJECT=stack
AWS_REGION=ap-northeast-2
AWS_AZ=ap-northeast-2a

# --- 도메인 ---
# Cloudflare zone 이름. NS 가 Cloudflare 를 가리켜야 합니다.
#
# 컨벤션: 이 stack 이 zone 하나를 통째로 점유합니다. 하위 도메인
# (stack.example.com)으로 내리면 Universal SSL 범위를 벗어나 유료 인증서가
# 필요하므로, 다른 용도와 나눠 쓸 거라면 도메인을 하나 더 등록하세요.
# 자세한 근거는 README 의 "도메인 컨벤션".
DOMAIN=example.com
# NS 확인을 건너뛰려면 1. 확인이 불가능할 때만 쓰세요.
# SKIP_NS_CHECK=1

# --- Cloudflare ---
# terraform 이 Cloudflare 를 직접 관리합니다(레코드·터널·Access·Rule).
# 토큰에 필요한 권한:
#   Account | Cloudflare Tunnel        | Edit
#   Account | Access: Apps and Policies| Edit
#   Zone    | Zone                     | Read
#   Zone    | DNS                      | Edit
#   Zone    | Transform Rules          | Edit
CLOUDFLARE_API_TOKEN=
# 대시보드 우측 하단 또는 URL 의 32자리 hex
CLOUDFLARE_ACCOUNT_ID=
#
# Grafana 와 SSH 에 들어올 수 있는 이메일. 쉼표로 구분합니다.
# 비면 Access 가 전부를 막아 SSH 조차 불가능해지므로 make up 이 거부합니다.
ACCESS_EMAILS=
#
# Cloudflare 를 거치지 않은 요청을 origin 에서 거르는 공유 비밀입니다.
# 01-foundation 이 이 값으로 Transform Rule 을 만들고, 03-proxy 의 nginx 가
# 같은 값을 확인합니다. 양쪽이 같은 .env 에서 나오므로 어긋날 수 없습니다.
#   openssl rand -hex 32
# 32자 미만이면 make up 이 거부합니다(terraform 쪽에도 같은 검증이 있습니다).
CF_ORIGIN_SECRET=

# --- EC2 ---
INSTANCE_TYPE=t4g.small
# INSTANCE_TYPE 과 반드시 일치해야 합니다. t4g.* -> arm64, t3.* -> amd64
INSTANCE_ARCH=arm64
ROOT_VOLUME_SIZE=20

# --- 영속 데이터 볼륨 (EC2 를 destroy 해도 남는 곳) ---
DATA_VOLUME_SIZE=30
# 스냅샷에서 복구할 때만 채웁니다. 비워두면 빈 볼륨을 새로 만듭니다.
# 복구가 끝나면 반드시 다시 비우세요. 남겨두면 다음에 볼륨을 새로 만들 때
# 몇 달 된 스냅샷이 조용히 복원됩니다.
DATA_SNAPSHOT_ID=

# --- SSH ---
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
# 위 공개키와 짝이 되는 개인키. ssh/rsync 가 -i 로 사용합니다.
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
#
# 접속 경로에는 설정할 것이 없습니다. SG 에 인바운드 규칙이 하나도 없고,
# 평상시에는 cloudflared 터널로(로컬에 cloudflared 필요), 터널이 죽었을 때는
# SSM Session Manager 로 들어갑니다(로컬에 awscli + session-manager-plugin 필요):
#
#   SSH_VIA=ssm make ssh
#
# .env 에 적는 값이 아니라 그때그때 붙이는 환경변수입니다.

# --- 04-monitoring ---
# 비워두면 make up 이 거부합니다. Grafana 앞에 Cloudflare Access 가 있지만,
# Access 정책을 잘못 열었을 때를 대비한 두 번째 자물쇠입니다.
#
# 8자 이상이어야 하고 admin/password 같은 자리표시자는 거부됩니다. 짧게 두면
# 최초 DB 생성은 통과하지만 make deploy 의 reset-admin-password 가 거부해서,
# 나중에 이 값을 고쳐도 실제 비밀번호가 영영 바뀌지 않습니다.
GRAFANA_ADMIN_PASSWORD=
